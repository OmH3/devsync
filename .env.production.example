# Copy to .env.production on the server (never commit the real file).
# Public hostname that points at the server; Caddy obtains the HTTPS certificate for it.
DOMAIN=devsync.example.com
PUBLIC_ORIGIN=https://devsync.example.com
FRONTEND_ORIGIN=https://devsync.example.com

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional features, off for the $0 demo.
GOOGLE_AUTH_ENABLED=false
AUDIO_ENABLED=false
LOG_LEVEL=info
