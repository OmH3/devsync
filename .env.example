# ==========================================
# DevSync Server Environment Configuration
# Copy to server/.env for local development
# ==========================================

# 1. Core Server & Database (Required)
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
BASE_PATH=/api
MONGO_URI=mongodb://127.0.0.1:27017/devsync?replicaSet=rs0

# 2. Session & Cookie Security (Required: SESSION_SECRET must be 32+ characters)
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-bytes-secret
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0

# 3. Origins & CORS
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated list when serving multiple origins:
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required only when NODE_ENV=production (must be https://...):
# PUBLIC_ORIGIN=https://devsync.example.com

# 4. Feature Flags
# Native WebRTC microphone-only voice rooms (no external SDK or credentials required)
AUDIO_ENABLED=true
# Local code runner (JavaScript, Python, C++). Must be false when NODE_ENV=production
CODE_EXECUTION_ENABLED=true
# Google OAuth (when true, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, and GOOGLE_CALLBACK_URL are required)
GOOGLE_AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
FRONTEND_GOOGLE_CALLBACK_URL=http://localhost:5173/google/callback

# 5. Optional Redis & Logging
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
LOG_PRETTY=false
