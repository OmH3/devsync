NODE_ENV=development
HOST=127.0.0.1
PORT=8000
BASE_PATH=/api
MONGO_URI=mongodb://127.0.0.1:27017/devsync?replicaSet=rs0
# Replace with a randomly generated secret before starting.
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_SECONDS=28800
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
GOOGLE_AUTH_ENABLED=false
AUDIO_ENABLED=false
CODE_EXECUTION_ENABLED=false
LOG_LEVEL=info
