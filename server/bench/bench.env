# Environment used ONLY by the benchmark runner (not secrets).
NODE_ENV=production
PORT=8000
BASE_PATH=/api
MONGO_URI=mongodb://localhost:27017/devsync_bench?replicaSet=rs0&directConnection=true
SESSION_SECRET=bench-secret
SESSION_EXPIRES_IN=1d
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_GOOGLE_CALLBACK_URL=http://localhost:5173/google/callback
STREAM_API_KEY=dummy
STREAM_API_SECRET=dummy
